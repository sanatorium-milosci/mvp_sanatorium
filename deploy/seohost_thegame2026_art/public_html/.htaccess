# deploy/seohost_thegame2026_art/public_html/.htaccess
# Konfiguracja dla thegame2026.art na hostingu seohost.pl (LiteSpeed / Apache)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Wymuszenie bezpiecznego połączenia HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Przekierowanie zapytań API do skryptu PHP
    RewriteRule ^api/v1/(.*)$ api/index.php?endpoint=$1 [QSA,L]
    RewriteRule ^healthz$ api/index.php?endpoint=zdrowie [QSA,L]

    # 3. Routing React SPA (jeśli żądany plik lub katalog nie istnieje)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Blokada bezpośredniego odczytu wrażliwych plików
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|env|lock|toml|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Kompresja GZIP / Deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Nagłówki bezpieczeństwa
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
